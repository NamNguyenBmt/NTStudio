{
  "name": "omnira-studio",
  "productName": "NT Studio",
  "version": "1.0.7",
  "description": "NT Studio – nền tảng quản lý & tự động hóa đa kênh trên desktop",
  "main": "./out/main/index.js",
  "author": "NT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "release": "node tools/release.js",
    "db:generate": "drizzle-kit generate",
    "verify": "electron-vite build && node tools/verify/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.49.0",
    "msedge-tts": "^2.0.8",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.4",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "electron-vite": "3.1.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21"
  }
}
